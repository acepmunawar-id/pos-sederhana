# Lingkungan aplikasi: development | production
APP_ENV=development
HTTP_PORT=8080
# Zona waktu toko (dipakai untuk nomor invoice harian & laporan)
APP_TIMEZONE=Asia/Jakarta

# Koneksi PostgreSQL
DATABASE_URL=postgres://pos:pos@localhost:5432/pos_db?sslmode=disable
DB_MAX_CONNS=10
# Jalankan migration otomatis saat server start
DB_AUTO_MIGRATE=true

# JWT — WAJIB diganti, minimal 32 karakter (contoh: openssl rand -hex 32)
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Origin web CMS (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upload gambar produk & logo
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads
MAX_UPLOAD_SIZE_MB=2
